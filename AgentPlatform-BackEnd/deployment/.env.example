# The one configuration file for the whole stack.
#
#   cp .env.example .env
#
# Docker Compose reads `.env` from this directory automatically — it is the
# directory holding docker-compose.yml, which is what makes it the project
# directory. Nothing here is required: `docker compose up --build` runs on
# localhost:8080 with every default below already applied, against the mock
# provider, offline, with no credentials.
#
# Two kinds of value live here, and the difference matters when you wonder why
# something did or did not take effect:
#
#   - Compose settings (WEB_PORT, POSTGRES_PASSWORD, CLOUDFLARE_TUNNEL_TOKEN)
#     shape the stack. They are substituted into docker-compose.yml and never
#     reach a container.
#   - Application settings (LLM_PROVIDER, GEMINI_API_KEY, the two limits) are
#     passed into the api container by the `environment:` block in
#     docker-compose.yml, which lists them explicitly. Adding a new setting to
#     app/config.py means adding a line there as well as here.
#
# This file is gitignored and holds credentials. Never commit it.


# --- Compose -----------------------------------------------------------------

# Host port the UI is published on.
WEB_PORT=8080

# Interface the port binds to. Leave as-is locally. On a public host set
# 127.0.0.1 so the only way in is the Cloudflare tunnel — otherwise the
# published port answers on the host's public IP and skips Cloudflare Access.
WEB_BIND=0.0.0.0

# Postgres applies this at initdb only. Against an existing pgdata volume it is
# ignored, so change it before the first boot or run `docker compose down -v`.
# docker-compose.yml builds DATABASE_URL from the same variable, so this is the
# only place it needs to change.
POSTGRES_PASSWORD=app


# --- Application -------------------------------------------------------------

# `mock` (default) runs the complete flow — tool calls, trace, execution logs —
# with no API calls and no billing. `adk_gemini` calls real Gemini and needs a
# key below. Rebuild the api image after switching: docker compose up -d --build api
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=adk_gemini.
GEMINI_API_KEY=

# Timeout for the http_request tool.
TOOL_HTTP_TIMEOUT_MS=5000

# Cap on tool payloads stored in run history. Oversized results are replaced
# with a truncation marker in the stored row only; the response is unaffected.
LOG_PAYLOAD_MAX_BYTES=32768


# --- docker-compose.prod.yml only --------------------------------------------

# Your public origin, used as the API's CORS fallback. Include the scheme.
# The prod overlay refuses to start without it.
# PUBLIC_ORIGIN=https://agents.example.com

# Token from Cloudflare Zero Trust > Networks > Tunnels. Point the tunnel's
# public hostname at http://web:80.
# CLOUDFLARE_TUNNEL_TOKEN=

# Keep LLM_PROVIDER on mock for a public instance: there is no authentication,
# so an open instance on adk_gemini lets anyone spend your Gemini credit. Set
# adk_gemini only behind Cloudflare Access.
