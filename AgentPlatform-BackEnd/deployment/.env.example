# The one configuration file for the whole stack.
#
#   cp .env.example .env
#
# Docker Compose reads `.env` from this directory automatically — it is the
# directory holding docker-compose.yml, which is what makes it the project
# directory. Nothing here is required: `docker compose up --build` runs on
# localhost:8080 with every default below already applied, against the mock
# provider, offline, with no credentials.
#
# Two kinds of value live here, and the difference matters when you wonder why
# something did or did not take effect:
#
#   - Compose settings (WEB_PORT, POSTGRES_PASSWORD, CLOUDFLARE_TUNNEL_TOKEN)
#     shape the stack. They are substituted into docker-compose.yml and never
#     reach a container.
#   - Application settings (LLM_PROVIDER, GEMINI_API_KEY, the two limits) are
#     passed into the api container by the `environment:` block in
#     docker-compose.yml, which lists them explicitly. Adding a new setting to
#     app/config.py means adding a line there as well as here.
#
# This file is gitignored and holds credentials. Never commit it.


# --- Compose -----------------------------------------------------------------

# Host port the UI is published on.
WEB_PORT=8090

# Interface the port binds to. Leave as-is locally. On a public host set
# 127.0.0.1 so the only way in is the Cloudflare tunnel. WEB_PASSWORD already
# guards this port — nginx serves it too — but the tunnel has Cloudflare in
# front of it and the host port has nothing, and on plain http the gate cookie
# travels without a Secure flag. Closing it costs LAN access from other
# devices; localhost keeps working.
WEB_BIND=0.0.0.0

# Postgres applies this at initdb only. Against an existing pgdata volume it is
# ignored, so change it before the first boot or run `docker compose down -v`.
# docker-compose.yml builds DATABASE_URL from the same variable, so this is the
# only place it needs to change.
POSTGRES_PASSWORD=app


# --- Application -------------------------------------------------------------

# `mock` (default) runs the complete flow — tool calls, trace, execution logs —
# with no API calls and no billing. `adk_gemini` calls real Gemini and needs a
# key below. Rebuild the api image after switching: docker compose up -d --build api
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=adk_gemini.
GEMINI_API_KEY=

# Timeout for the http_request tool.
TOOL_HTTP_TIMEOUT_MS=5000

# Cap on tool payloads stored in run history. Oversized results are replaced
# with a truncation marker in the stored row only; the response is unaffected.
LOG_PAYLOAD_MAX_BYTES=32768


# --- docker-compose.prod.yml only --------------------------------------------

# The trigger scheduler. `false` keeps the /api/triggers routes answering and
# stops only the clock, so nothing fires on its own. Leave it on unless you have
# a reason: an interval trigger is an unattended agent run every N minutes, and
# on a live provider that is real usage with nobody watching.
TRIGGERS_ENABLED=true

# How often the scheduler wakes, and the most runs it will dispatch per wake.
# The ceiling matters more than it looks: 20 per 30s tick is the upper bound on
# how fast triggers can drive the provider.
TRIGGER_TICK_SECONDS=30
TRIGGER_MAX_PER_TICK=20


# Password for the web gate. Empty (the default) leaves the site open, which is
# what makes `docker compose up --build` work with no setup at all. Set it and
# nginx puts a login page in front of both the UI and /api — the check runs in
# nginx, so curl is gated too, not just the browser.
#
# The visitor types this once; it is stored as a cookie for a year, so they are
# not asked again on that browser. There is no logout and no per-person
# identity: changing the password here and recreating the web container is what
# revokes access, and it revokes it for everyone at once.
#
# It travels as a raw cookie value, so keep it free of spaces, semicolons,
# commas and equals signs. A hyphenated passphrase is the easy way to do that.
WEB_PASSWORD=change-me-before-going-public


# Your public origin, used as the API's CORS fallback. Include the scheme.
# The prod overlay refuses to start without it.
# PUBLIC_ORIGIN=https://agents.example.com

# Token from Cloudflare Zero Trust > Networks > Tunnels. Point the tunnel's
# public hostname at http://web:80.
# CLOUDFLARE_TUNNEL_TOKEN=

# The API itself has no authentication: every route is open, including DELETE
# /api/agents/:id and the whole of /api/triggers, where one interval trigger is
# an unattended agent run every minute. WEB_PASSWORD above is what stands in
# front of all of it, so on a public instance either set it, or keep
# LLM_PROVIDER on mock and accept that strangers can delete the seeded agents.
