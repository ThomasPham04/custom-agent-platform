PORT=4000
# nginx proxies /api on the same origin, so the browser never sends a
# cross-origin request and this value is only a fallback for direct access.
CORS_ORIGIN=http://localhost:8080

# `db` is the compose service name; the API waits for its healthcheck.
STORE_BACKEND=postgres
DATABASE_URL=postgresql://app:app@db:5432/agents

# Set adk_gemini and supply a key to demo against real Gemini. With `mock` the
# stack runs offline and the trace still renders.
LLM_PROVIDER=mock
GEMINI_API_KEY=

TOOL_HTTP_TIMEOUT_MS=5000
LOG_PAYLOAD_MAX_BYTES=32768
