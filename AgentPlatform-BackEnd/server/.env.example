PORT=4000
CORS_ORIGIN=http://localhost:5173

# Deployment default. The code default is `memory` so the service and pytest run
# with no database.
STORE_BACKEND=postgres
DATABASE_URL=postgresql://app:app@db:5432/agents

LLM_PROVIDER=mock
GEMINI_API_KEY=

TOOL_HTTP_TIMEOUT_MS=5000
LOG_PAYLOAD_MAX_BYTES=32768

# Request body caps, both in bytes. Keep the knowledge one comfortably below
# MAX_BODY_BYTES so an oversized document is refused with its own message
# rather than by the body limiter.
MAX_BODY_BYTES=262144
KNOWLEDGE_MAX_BODY_BYTES=100000

# The scheduler is one background task in the lifespan. false stops the clock
# and leaves the REST surface (including fire-now) working.
TRIGGERS_ENABLED=true
TRIGGER_TICK_SECONDS=30
TRIGGER_MAX_PER_TICK=20
